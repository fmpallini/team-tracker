# Normalize line endings in the repository and check out LF everywhere (overrides
# core.autocrlf), so working tree matches the index and editors/tools writing LF.
* text=auto eol=lf

# Shell scripts must stay LF — a CRLF shebang line breaks bash outright,
# and this hook has to run via git-bash on Windows just as reliably as on
# macOS/Linux.
*.sh text eol=lf
.githooks/pre-push text eol=lf

# Binary assets — never touch these.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
