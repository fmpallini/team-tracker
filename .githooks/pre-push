#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
gate_ok()   { echo -e "${GREEN}[ OK ]${NC}  $1"; }
gate_fail() { echo -e "${RED}[ FAIL ]${NC} $1 — $2"; exit 1; }
gate_warn() { echo -e "${YELLOW}[ WARN ]${NC} $1"; }
gate_run()  { echo -e "\n${BLUE}[ RUNNING ]${NC} $1..."; }
pass_and_exit() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo -e "${GREEN} $1${NC}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 0
}

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")

# What is this push actually doing? git answers on stdin, one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# The hook used to ask the checked-out branch instead, which got three
# everyday cases wrong: `git push origin v2.8.3` (every release) ran the
# dev-only gates against a diff unrelated to the tag; `git push origin
# HEAD:dev` from another branch skipped them all; a branch delete ran the
# full suite for nothing. <remote sha> is also the true diff base — the local
# origin/dev tracking ref only reflects whenever you last fetched.
#
# Stdin is a terminal when the hook is run by hand rather than by git; fall
# back to the checked-out branch against origin/dev in that case.
is_zero() { [ -z "${1//0/}" ]; }   # git's all-zeros sha: ref absent on that side

PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)

PUSHING_DEV=0     # 1 when some ref in this push lands on refs/heads/dev
PUSH_TO=""        # commit being pushed to dev
PUSH_FROM=""      # commit remote dev had before this push; empty = none/unknown
if [ -n "$PUSH_REFS" ]; then
  PUSHING_BRANCH=0
  while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    is_zero "$local_sha" && continue    # ref deletion: nothing new lands
    case "$remote_ref" in refs/heads/*) PUSHING_BRANCH=1 ;; esac
    if [ "$remote_ref" = "refs/heads/dev" ]; then
      PUSHING_DEV=1
      PUSH_TO="$local_sha"
      is_zero "$remote_sha" || PUSH_FROM="$remote_sha"
    fi
  done <<< "$PUSH_REFS"

  # Only tags and/or deletions. A release tag points at a commit that already
  # passed the dev -> main PR's CI; re-running the suite against the working
  # tree proves nothing about it.
  if [ "$PUSHING_BRANCH" = "0" ]; then
    echo "Pre-push: no branch updates in this push (tags/deletions only) — gates skipped."
    exit 0
  fi
elif [ "$BRANCH" = "dev" ]; then
  PUSHING_DEV=1
  PUSH_TO=$(git rev-parse HEAD)
  PUSH_FROM=$(git rev-parse --verify -q "origin/dev^{commit}" || true)
fi

# Remote dev must be an ancestor of what is being pushed, or git rejects the
# push as non-fast-forward. The usual cause is a release: main's merge commit
# lands on dev through .github/workflows/sync-dev.yml, so this clone is one
# commit behind. Fail now rather than after lint/typecheck/tests have run.
# <remote sha> may name a commit this clone never fetched (cat-file fails).
if [ "$PUSHING_DEV" = "1" ] && [ -n "$PUSH_FROM" ]; then
  if ! git cat-file -e "${PUSH_FROM}^{commit}" 2>/dev/null      || ! git merge-base --is-ancestor "$PUSH_FROM" "$PUSH_TO"; then
    gate_fail "Remote dev" "origin/dev has commits this branch lacks (a release sync, or another machine). Run 'git pull --rebase', then push again"
  fi
fi

# Changed files between the remote's dev and what's being pushed — the commits
# this push actually lands, not the whole history of dev. Computed once, reused
# by the test-coverage and changelog gates.
PUSH_DIFF_FILES=""
PUSH_DIFF_ADDED=""
if [ "$PUSHING_DEV" = "1" ] && [ -n "$PUSH_FROM" ]; then
  PUSH_DIFF_FILES=$(git diff --name-only --diff-filter=ACMR "$PUSH_FROM" "$PUSH_TO" 2>/dev/null || true)
  PUSH_DIFF_ADDED=$(git diff --name-only --diff-filter=A "$PUSH_FROM" "$PUSH_TO" 2>/dev/null || true)
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " Pre-push quality gate"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Lint/typecheck/tests run on the working tree. The diff-based gates below read
# the pushed commit itself, but these three can't without a second checkout —
# so say so when the two differ (e.g. `git push origin other-branch:dev`).
if [ "$PUSHING_DEV" = "1" ] && [ "$PUSH_TO" != "$(git rev-parse HEAD)" ]; then
  gate_warn "Pushing ${PUSH_TO:0:9} to dev, but HEAD is $(git rev-parse --short=9 HEAD) — lint/typecheck/tests check the working tree, not the pushed commit"
fi

# ─── PHASE 1: DETERMINISTIC GATES ────────────────────────────────────────────

# Gates 1-3 go through the npm scripts rather than calling eslint/tsc/vitest
# directly, so this hook and CI (.github/workflows/ci.yml's `check` job, which
# runs the same three scripts) can't drift apart when a script gains a flag.

# 1. Lint
gate_run "Lint"
if npm run lint 2>&1; then
  gate_ok "Lint"
else
  gate_fail "Lint" "fix lint errors above then push again"
fi

# 2. TypeCheck
gate_run "TypeCheck"
if npm run typecheck 2>&1; then
  gate_ok "TypeCheck"
else
  gate_fail "TypeCheck" "fix type errors above then push again"
fi

# 3. Tests
gate_run "Tests"
if npm test 2>&1; then
  gate_ok "Tests"
else
  gate_fail "Tests" "fix failing tests then push again"
fi

# E2E (Playwright) and the npm audit / npm outdated checks used to live here
# as gates 4, 6 and 7. E2E moved to CI (.github/workflows/ci.yml's `e2e` job,
# on every dev push + PRs into main) so pushes stay fast and its enforcement
# survives a missing hook / --no-verify. The dependency checks moved to a
# weekly workflow (.github/workflows/deps-audit.yml). What's left here is the
# fast deterministic set plus the cheap changelog nag.

# 4. Test coverage sanity — enforces CLAUDE.md's "every src module gets a
# matching test/*.test.ts" convention for *new* files (hard fail; the
# convention is real and near-100% today, so a new file skipping it is a
# mistake, not a style choice). Modified-but-not-new files only get a
# non-blocking nudge, since not every edit needs a new assertion and this
# hook can't judge that.
gate_run "Test coverage sanity"
if [ "$PUSHING_DEV" != "1" ]; then
  gate_warn "Test coverage sanity — skipped (only enforced on pushes to dev)"
elif [ -z "$PUSH_DIFF_FILES" ]; then
  gate_ok "Test coverage sanity (no diff against remote dev)"
else
  MISSING=""
  UNCOVERED=""
  while IFS= read -r f; do
    case "$f" in
      src/*.ts) ;;
      *) continue ;;
    esac
    case "$f" in
      src/core/types.ts|src/main.ts|*.d.ts) continue ;;
    esac
    base=$(basename "$f" .ts)
    test_file="test/${base}.test.ts"
    if ! git cat-file -e "${PUSH_TO}:${test_file}" 2>/dev/null; then
      if printf '%s\n' "$PUSH_DIFF_ADDED" | grep -qxF "$f"; then
        MISSING="$MISSING\n  $f  (expected $test_file)"
      fi
    elif ! printf '%s\n' "$PUSH_DIFF_FILES" | grep -qxF "$test_file"; then
      UNCOVERED="$UNCOVERED\n  $f  ($test_file not touched in this push)"
    fi
  done <<< "$PUSH_DIFF_FILES"

  if [ -n "$MISSING" ]; then
    gate_fail "Test coverage sanity" "new src file(s) with no matching test/*.test.ts:$MISSING"
  else
    gate_ok "Test coverage sanity"
    if [ -n "$UNCOVERED" ]; then
      gate_warn "Test coverage sanity — modified without touching their test file (confirm this is intentional):$UNCOVERED"
    fi
  fi
fi

# 5. Changelog entry — if this push bumps package.json's version but adds no
# matching "## [x.y.z]" section to CHANGELOG.md, nag. Non-blocking on purpose:
# the bump and the entry may land in separate commits within one push cycle.
# CI's changelog-gate hard-fails the same check on the dev -> main PR, against
# the origin/main baseline (the true last release).
gate_run "Changelog entry"
if [ "$PUSHING_DEV" != "1" ]; then
  gate_warn "Changelog entry — skipped (only checked on pushes to dev)"
elif ! printf '%s\n' "$PUSH_DIFF_FILES" | grep -qxF "package.json"; then
  gate_ok "Changelog entry (package.json not in this push)"
else
  extract_ver() { grep -m1 '"version"' | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'; }
  HEAD_VER=$( { git show "${PUSH_TO}:package.json" 2>/dev/null | extract_ver; } || echo "")
  BASE_VER=$( { git show "${PUSH_FROM}:package.json" 2>/dev/null | extract_ver; } || echo "")
  if [ -z "$HEAD_VER" ] || [ -z "$BASE_VER" ] || [ "$HEAD_VER" = "$BASE_VER" ]; then
    gate_ok "Changelog entry (version unchanged)"
  elif git show "${PUSH_TO}:CHANGELOG.md" 2>/dev/null | grep -qF "## [${HEAD_VER}]"; then
    gate_ok "Changelog entry (## [${HEAD_VER}] present)"
    # Brevity nag (non-blocking): an entry names what changed for the user in a
    # line or two, not every screen or button it touched. Only this version's
    # section is measured — older entries are history.
    ENTRY=$(git show "${PUSH_TO}:CHANGELOG.md" 2>/dev/null | awk -v h="## [${HEAD_VER}]" 'index($0,h)==1{f=1;next} /^## \[/{f=0} f')
    LONG_BULLETS=$(printf '%s\n' "$ENTRY" | awk 'length($0) > 200' | wc -l | tr -d ' ')
    BULLETS=$(printf '%s\n' "$ENTRY" | grep -c '^- ' || true)
    if [ "$LONG_BULLETS" -gt 0 ] || [ "$BULLETS" -gt 6 ]; then
      gate_warn "Changelog entry — ## [${HEAD_VER}] is wordy (${BULLETS} bullets, ${LONG_BULLETS} over 200 chars). Aim for a line or two per change and fold related ones together; don't list every button or screen touched (see .claude/skills/changelog)"
    fi
  else
    gate_warn "Changelog entry — package.json ${BASE_VER} -> ${HEAD_VER} but CHANGELOG.md has no '## [${HEAD_VER}]' section yet (CI blocks the dev -> main PR until it does)"
  fi
fi

pass_and_exit "All gates passed. Pushing..."
